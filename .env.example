# CrawlRX settings. Copy to .env (the install scripts do this for you).

# --- AI model (optional: only /extract and /vision need one) -----------------
# One setting: the base URL of any OpenAI-compatible server. Leave empty to
# auto-detect Ollama (port 11434) or LM Studio (port 1234).
#   Ollama:     http://localhost:11434/v1   (from Docker: http://host.docker.internal:11434/v1)
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://your-server:8000/v1
#   Cloud:      https://api.openai.com/v1   (or any OpenAI-compatible provider)
CRAWLRX_LLM_BASE_URL=
CRAWLRX_LLM_API_KEY=
# Model ids; empty = pick from what the server offers.
CRAWLRX_LLM_MODEL=
CRAWLRX_VISION_MODEL=
# Reasoning models (qwen3, deepseek-r1...) are retried with reasoning off when they
# return only thinking. Force a value (none|low|medium|high) here if needed.
CRAWLRX_LLM_REASONING_EFFORT=
# Model pulled by `docker compose --profile ollama up`.
CRAWLRX_OLLAMA_MODEL=qwen2.5vl:3b

# --- Server --------------------------------------------------------------------
CRAWLRX_PORT=7337
# 127.0.0.1 = this machine only. Use 0.0.0.0 to expose, and then ALSO set API keys.
CRAWLRX_BIND=127.0.0.1
# Comma-separated keys clients must send as X-API-Key. Empty = no auth (local use).
# CrawlRX refuses to start on a non-loopback bind without keys
# (override with CRAWLRX_ALLOW_NO_AUTH=1 on a trusted network).
CRAWLRX_API_KEYS=
CRAWLRX_ALLOW_NO_AUTH=
# Websites allowed to call the API from a browser (CORS). Empty = none.
# e.g. chrome-extension://<extension-id>,https://my-dashboard.example
CRAWLRX_CORS_ORIGINS=
CRAWLRX_BROWSER_POOL=2

# --- Interaction challenges -----------------------------------------------------
# Challenges are solved automatically when a solver can (CRAWLRX_CAPTCHA_MODE below);
# otherwise this hand-off decides what happens:
#   none    = report "captcha_required" to the caller (default; servers/Docker)
#   browser = open a visible browser and wait for you to solve it (desktop only)
CRAWLRX_CAPTCHA_HANDOFF=none
CRAWLRX_CAPTCHA_WAIT=180

# Challenge solving: solve (default) = try solvers first, then the hand-off above; handoff = off.
# Respect each site's terms; you are responsible for how you use this.
CRAWLRX_CAPTCHA_MODE=solve
# Limit which solvers run (comma list): flaresolverr, recaptcha-audio, service. Empty = all usable.
CRAWLRX_SOLVERS=
# The external challenge gateway runs in the Docker stack automatically. Without Docker,
# run it yourself and point this at it:
# CRAWLRX_FLARESOLVERR_URL=http://localhost:8191/v1
# A 2Captcha-compatible solving service you run yourself (no service or key is bundled).
CRAWLRX_SOLVER_SERVICE_URL=
CRAWLRX_SOLVER_SERVICE_KEY=

# --- Search --------------------------------------------------------------------
SEARXNG_PORT=8888
# Random string; the install scripts generate one.
SEARXNG_SECRET=
